# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Elliott Mazzuca <emazzuca@qnx.com>
pkgname=mpc1
pkgver=1.3.1
pkgrel=0
pkgdesc="Multiple precision complex arithmetic library"
url="https://www.multiprecision.org/mpc/"
arch="all"
license="LGPL-3.0-or-later"
depends="gmp mpfr"
depends_dev="gmp-dev mpfr-dev"
makedepends="$depends_dev"
subpackages="$pkgname-dev $pkgname-doc"
source="https://ftp.gnu.org/gnu/mpc/mpc-$pkgver.tar.gz"
builddir="$srcdir/mpc-$pkgver"

build() {
  cd "$builddir"

  ./configure \
    --build=$CBUILD \
    --host=$CHOST \
    --prefix=/usr \
    --disable-static \
    --enable-shared

  make
}

check() {
  cd "$builddir"
  make check
}

package() {
  cd "$builddir"
  make DESTDIR="$pkgdir" install
}

sha512sums="
